{
  "manifest_version": 3,
  "name": "CourseCraft - Learning & Automation Assistant",
  "version": "4.6.0",
  "version_name": "4.6.0 (CourseCraft Marathon)",
  "author": "CourseCraft Open Source",
  "description": "Automate routine course tasks, backup course materials, bulk-complete lectures, and assist study workflows on Coursera.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "commands",
    "downloads",
    "cookies"
  ],
  "background": {
    "service_worker": "dist/scripts/background.js"
  },
  "icons": {
    "16": "dist/assets/1.png",
    "32": "dist/assets/2.png",
    "48": "dist/assets/3.png",
    "128": "dist/assets/4.png"
  },
  "action": {
    "default_popup": "dist/popup.html"
  },
  "options_page": "dist/settings.html",
  "content_scripts": [
    {
      "run_at": "document_start",
      "matches": [
        "*://*.coursera.org/*"
      ],
      "js": [
        "dist/scripts/xyz.js",
        "dist/scripts/content.js"
      ],
      "css": [
        "dist/ui/content.css"
      ],
      "all_frames": false
    }
  ],
  "commands": {
    "open_popup_1": {
      "suggested_key": {
        "default": "Alt+B",
        "mac": "Command+B"
      },
      "description": "Open CourseCraft popup"
    },
    "open_popup_2": {
      "suggested_key": {
        "default": "Alt+W",
        "mac": "Command+W"
      },
      "description": "Toggle CourseCraft popup"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dist/scripts/rdr.js"
      ],
      "matches": [
        "*://*.coursera.org/*"
      ]
    }
  ],
  "host_permissions": [
    "*://*.coursera.org/*",
    "https://generativelanguage.googleapis.com/*"
  ]
}